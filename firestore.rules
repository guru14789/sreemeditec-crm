
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'sreekumar.career@gmail.com' ||
        (exists(/databases/$(database)/documents/uid_maps/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/uid_maps/$(request.auth.uid)).data.role == 'SYSTEM_ADMIN')
      );
    }

    function getCallerEmployeeId() {
      return exists(/databases/$(database)/documents/uid_maps/$(request.auth.uid)) ?
        get(/databases/$(database)/documents/uid_maps/$(request.auth.uid)).data.employeeId :
        request.auth.uid;
    }

    // Lead CRM access rules
    match /leads/{leadId} {
      allow read: if isAuthenticated() && (
        isSystemAdmin() ||
        resource.data.employeeId == request.auth.uid ||
        resource.data.salesTakenById == request.auth.uid ||
        resource.data.employeeId == getCallerEmployeeId() ||
        resource.data.salesTakenById == getCallerEmployeeId() ||
        !exists(/databases/$(database)/documents/uid_maps/$(request.auth.uid))
      );
      allow create: if isAuthenticated() && (
        isSystemAdmin() ||
        request.resource.data.employeeId == getCallerEmployeeId() ||
        request.resource.data.salesTakenById == getCallerEmployeeId() ||
        request.resource.data.employeeId == request.auth.uid ||
        !exists(/databases/$(database)/documents/uid_maps/$(request.auth.uid))
      );
      allow update: if isAuthenticated() && (
        isSystemAdmin() ||
        resource.data.employeeId == getCallerEmployeeId() ||
        resource.data.salesTakenById == getCallerEmployeeId() ||
        resource.data.employeeId == request.auth.uid ||
        !exists(/databases/$(database)/documents/uid_maps/$(request.auth.uid))
      );
      allow delete: if isSystemAdmin();
    }

    // Default catch-all for authenticated users
    match /{collectionName}/{docId} {
      allow read, create, update, delete: if isAuthenticated() && 
        collectionName != 'leads' && 
        collectionName != 'employees' && 
        collectionName != 'admin_secrets' && 
        collectionName != 'publicEmployeeProfiles';
    }

    // Registry access rules
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSystemAdmin();
    }

    // Protected admin secrets - strictly server-side verified for system admins
    match /admin_secrets/{secretId} {
      allow read, write: if isSystemAdmin();
    }

    // Public Employee Profiles - unauthenticated public read for QR scans, admin-only write
    match /publicEmployeeProfiles/{publicProfileId} {
      allow read: if true;
      allow create, update, delete: if isSystemAdmin();
    }

    // UID to role map access rules
    match /uid_maps/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == uid || isSystemAdmin());
      allow delete: if isSystemAdmin();
    }

    // Specific validation for tasks (allow admins/authenticated users to delete)
    match /tasks/{taskId} {
      allow create, update, delete: if isAuthenticated() && 
        request.resource.data.title is string &&
        request.resource.data.status in ['To Do', 'In Progress', 'Review', 'Done'];
    }
  }
}
